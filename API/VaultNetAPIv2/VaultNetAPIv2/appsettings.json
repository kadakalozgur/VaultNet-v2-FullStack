{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Serilog.AspNetCore.RequestLoggingMiddleware": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vaultnet-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 3,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Enter your database address here."
  },
  "JwtSettings": {
    "SecretKey": "Enter your secret key here.",
    "Issuer": "VaultNetServer",
    "Audience": "VaultNetClient",
    "ExpireMinutes": 5
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "Enter your frontend address here."
    ]
  },
  "Supabase": {
    "Url": "https://your-project-id.supabase.co",
    "Key": "your-api-key-value"
  }
}
